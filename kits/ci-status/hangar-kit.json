{
  "schema": 1,
  "id": "ci-status",
  "name": "CI status",
  "version": "0.1.0",
  "description": "A tab that follows a GitHub Actions run, opened by itself after a git push.",
  "author": "Hangar",
  "homepage": "https://github.com/simnJS/hangar-ai/tree/main/kits/ci-status",
  "icon": "icon.svg",
  "hangar": ">=1.9.0",
  "commands": {
    "ci-run": {
      "description": "The state of one GitHub Actions run: status, conclusion, jobs and their steps.",
      "run": [
        "gh", "run", "view", "{id}",
        "--json", "status,conclusion,displayTitle,headBranch,workflowName,url,jobs,startedAt,updatedAt"
      ],
      "args": { "id": { "pattern": "[0-9]+", "description": "The run's number" } },
      "timeoutSeconds": 30
    },
    "ci-list": {
      "description": "The 15 most recent GitHub Actions runs of the workspace's repository.",
      "run": [
        "gh", "run", "list", "--limit", "15",
        "--json", "databaseId,displayTitle,workflowName,headBranch,status,conclusion,createdAt"
      ],
      "timeoutSeconds": 30
    },
    "ci-log": {
      "description": "The log of the steps that failed in one GitHub Actions run.",
      "run": ["gh", "run", "view", "{id}", "--log-failed"],
      "args": { "id": { "pattern": "[0-9]+", "description": "The run's number" } },
      "timeoutSeconds": 60
    }
  },
  "tabs": [
    {
      "id": "ci",
      "title": "CI",
      "entry": "tabs/ci/index.html",
      "icon": "icon.svg",
      "permissions": ["command:ci-run", "command:ci-list", "command:ci-log", "notify"],
      "params": {
        "id": { "description": "The GitHub Actions run's number (digits only). Without it the tab lists the recent runs.", "pattern": "[0-9]+" }
      }
    }
  ]
}
