{
  "recursiveDelete": {
    "what": "rm -r, rimraf, find -delete and their Windows forms, when they reach outside the project, or take the whole project with them. What is inside the project passes.",
    "enabled": true,
    "allowedOutsideProject": ["$TMPDIR", "$TEMP", "$TMP", "/tmp", "/var/tmp", "/private/tmp"],
    "protectedInsideProject": [".git"]
  },
  "forcePush": {
    "what": "git push --force, -f, --force-with-lease or a +refspec to one of these branches, or to what origin/HEAD names. A feature branch passes.",
    "enabled": true,
    "defaultBranches": ["main", "master", "trunk"]
  },
  "gitResetHard": {
    "what": "git reset --hard.",
    "enabled": true
  },
  "gitClean": {
    "what": "git clean with --force, unless it is a dry run.",
    "enabled": true
  },
  "dropDatabase": {
    "what": "SQL matching `sql` given to a database client (as an argument, a here-document, or piped from echo), and these commands, each word in this order.",
    "enabled": true,
    "clients": ["psql", "mysql", "mariadb", "sqlcmd", "mongosh", "mongo", "cockroach", "clickhouse-client", "clickhouse"],
    "sql": "\\bdrop\\s+(database|schema)\\b|\\bdropDatabase\\s*\\(",
    "commands": [
      ["dropdb"],
      ["mysqladmin", "drop"],
      ["rails", "db:drop"],
      ["rake", "db:drop"],
      ["mix", "ecto.drop"],
      ["php", "artisan", "db:wipe"],
      ["prisma", "migrate", "reset"],
      ["dotnet", "ef", "database", "drop"]
    ]
  },
  "downloadToShell": {
    "what": "A download piped into a shell or an interpreter reading its code from stdin, given to one through $(…) or <(…), or saved and run in the same command line.",
    "enabled": true,
    "downloaders": ["curl", "wget", "fetch", "http", "https", "aria2c", "iwr", "irm", "invoke-webrequest", "invoke-restmethod"],
    "interpreters": ["python", "node", "perl", "ruby", "php", "bun", "deno"]
  },
  "secrets": {
    "what": "Reading, printing, copying or uploading these files with the Read, Edit, Write and Grep tools, or in a command line through the programs below. Without a slash a pattern is a file's name, with one the end of its path, and ~/ ties it to the home folder. Loading a .env for a program (source .env, node --env-file=.env) passes: nothing is shown.",
    "enabled": true,
    "paths": [
      ".env", ".env.*", "*.env", ".envrc",
      "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "id_ecdsa_sk", "id_ed25519_sk", "id_xmss",
      "*.pem", "*.key", "*.p12", "*.pfx", "*.ppk", "*.jks", "*.keystore",
      ".ssh/*", ".gnupg/*", ".aws/*", ".azure/*",
      ".netrc", "_netrc", ".pgpass", ".my.cnf", ".git-credentials", ".htpasswd", ".pypirc",
      "~/.npmrc",
      ".docker/config.json", ".kube/config", ".config/gh/hosts.yml",
      "gcloud/application_default_credentials.json", "gcloud/credentials.db",
      ".terraform.d/credentials.tfrc.json",
      ".claude/.credentials.json", ".hangar/endpoint.json",
      "credentials.json", "credentials.yml", "credentials.yaml", "credentials.toml",
      "secrets.json", "secrets.yml", "secrets.yaml", "secrets.toml",
      "service-account*.json", "serviceaccount*.json", "*-service-account.json",
      "etc/shadow"
    ],
    "except": [
      ".env.example", ".env.sample", ".env.template", ".env.dist", ".env.defaults", ".env.schema", ".env.d.ts",
      ".env*.example", ".env*.sample", ".env*.template",
      "*.pub",
      ".ssh/config", ".ssh/known_hosts", ".ssh/known_hosts.old", ".ssh/authorized_keys",
      "*cert.pem", "*chain.pem", "*public*.pem", "ca.pem", "ca-*.pem", "*-ca.pem"
    ],
    "readers": [
      "cat", "tac", "nl", "head", "tail", "less", "more", "most", "bat", "batcat", "view", "vi", "vim", "nvim", "nano", "emacs", "ed",
      "grep", "egrep", "fgrep", "rg", "ag", "ack", "findstr", "sed", "awk", "gawk", "mawk",
      "cut", "sort", "uniq", "paste", "column", "fold", "fmt", "pr", "rev", "expand", "iconv",
      "xxd", "od", "hexdump", "hd", "strings", "base64", "base32", "openssl", "jq", "yq",
      "diff", "sdiff", "cmp", "comm", "tar", "zip", "7z", "gzip", "bzip2", "xz", "dd",
      "type", "get-content", "gc", "select-string", "sls", "pbcopy", "xclip", "xsel", "clip"
    ],
    "copiers": ["cp", "mv", "scp", "rsync", "install", "ditto", "copy", "move", "copy-item", "move-item"]
  },
  "guardFiles": {
    "what": "Changing the guard's own files: its data folder (one-time passes live there), .hangar/guard.json, and the kit's folder unless it lies inside the project. Those are the person's to change.",
    "enabled": true,
    "readers": ["cat", "ls", "dir", "head", "tail", "less", "more", "bat", "grep", "rg", "jq", "wc", "stat", "file", "diff", "git", "echo", "printf", "test", "[", "[["]
  }
}
