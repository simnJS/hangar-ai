{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the workspace windows",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "notification:default"
  ]
}
