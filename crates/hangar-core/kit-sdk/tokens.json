{
  "$comment": "What each colour token of Hangar UI means, and the chrome token of hangar-theme it comes from. scripts/gen-hangar-ui.mjs writes kit.css from it; the window's theme event (docs/kit-ui.md) sends the same names. Not served to kits.",
  "themes": {
    "dark": "graphite",
    "light": "github-light"
  },
  "colors": {
    "--kit-bg": "--chrome",
    "--kit-surface": "--card",
    "--kit-raised": "--raised",
    "--kit-float": "--chrome-bar",
    "--kit-field": "--bg",
    "--kit-well": "--bg-sunken",
    "--kit-hover": "--surface-hover",
    "--kit-selected": "--surface-active",
    "--kit-seg-track": "--seg-track",
    "--kit-seg-thumb": "--seg-thumb",

    "--kit-text": "--fg",
    "--kit-text-dim": "--fg-secondary",
    "--kit-text-muted": "--fg-muted",
    "--kit-text-faint": "--fg-subtle",

    "--kit-line": "--line",
    "--kit-border": "--line-strong",
    "--kit-border-hover": "--border-strong",
    "--kit-sep": "--sep",

    "--kit-accent": "--accent",
    "--kit-accent-text": "--accent-hi",
    "--kit-accent-soft": "--accent-soft",
    "--kit-accent-ring": "--accent-ring",
    "--kit-on-accent": "--accent-fg",
    "--kit-focus": "--accent-hi",

    "--kit-ok": "--success",
    "--kit-ok-fill": "--state-working-fill",
    "--kit-warn": "--warning",
    "--kit-warn-fill": "--state-waiting-fill",
    "--kit-danger": "--danger",
    "--kit-danger-soft": "--danger-soft",
    "--kit-neutral": "--state-idle",
    "--kit-neutral-fill": "--state-idle-fill",

    "--kit-shadow": "--shadow",
    "--kit-float-ring": "--float-ring"
  }
}
